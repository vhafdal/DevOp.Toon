pipeline {
    agent { label 'dotnet' }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'GIT_REF', defaultValue: 'main', description: 'main for validation, or immutable annotated vMAJOR.MINOR.PATCH tag for publishing')
        booleanParam(name: 'PUSH_NUGET', defaultValue: false, description: 'Publish the validated tagged package; an existing version fails on every target feed')
        choice(name: 'NUGET_TARGET', choices: ['all', 'nuget.org', 'private'], description: 'Feeds for PUSH_NUGET: all = NuGet.org then the private feed; private alone is for a repair or an urgent internal release')
    }

    environment {
        PROJECT = 'src/DevOp.Toon/DevOp.Toon.csproj'
        CONFIG = 'Release'
        NUGET_OUTPUT = './nupkg'
        NUGET_SOURCE = 'https://api.nuget.org/v3/index.json'
        PRIVATE_NUGET_SOURCE = 'https://nuget.devop.is/v3/index.json'
        DOTNET_CLI_TELEMETRY_OPTOUT = '1'
        DOTNET_NOLOGO = 'true'
        TEST_PROJECT = 'tests/DevOp.Toon.Tests/DevOp.Toon.Tests.csproj'
        TEST_FRAMEWORK = 'net10.0'
    }

    stages {
        stage('Checkout requested ref') {
            steps {
                deleteDir()
                script {
                    def requested = (params.GIT_REF ?: 'main').trim()
                    if (!(requested == 'main' || requested ==~ /v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)/)) {
                        error('GIT_REF must be main or a stable vMAJOR.MINOR.PATCH tag')
                    }
                    if (scm.userRemoteConfigs.size() != 1) {
                        error('Expected one configured Git remote')
                    }
                    def remotes = scm.userRemoteConfigs.collect { remote ->
                        [url: remote.url, credentialsId: remote.credentialsId, name: 'origin',
                         refspec: '+refs/heads/main:refs/remotes/origin/main +refs/tags/*:refs/tags/*']
                    }
                    checkout scmGit(
                        branches: [[name: requested == 'main' ? '*/main' : 'refs/tags/' + requested]],
                        extensions: [cloneOption(noTags: false, shallow: false, honorRefspec: true)],
                        userRemoteConfigs: remotes)
                    env.REQUESTED_REF = requested
                    env.PUBLISH_REQUESTED = params.PUSH_NUGET.toString()
                }
            }
        }

        stage('Verify release source') {
            steps {
                container('dotnet') {
                    sh '''
                        set -eu
                        dotnet --info
                        sh tools/validate-release.sh source "$PROJECT" "$REQUESTED_REF" "$PUBLISH_REQUESTED" > release-proof.txt
                        cat release-proof.txt
                    '''
                }
            }
        }

        stage('Build and test') {
            steps {
                container('dotnet') {
                    sh '''
                        set -eu
                        dotnet restore "$PROJECT"
                        dotnet build "$PROJECT" -c "$CONFIG" --no-restore -p:ContinuousIntegrationBuild=true
                        dotnet test "$TEST_PROJECT" -c "$CONFIG" -f "$TEST_FRAMEWORK" -p:ContinuousIntegrationBuild=true --results-directory "$WORKSPACE/test-results" --logger "trx;LogFileName=release-tests.trx"
                        sh tools/validate-release.sh tests "$WORKSPACE/test-results" 1 >> release-proof.txt
                        cat release-proof.txt
                    '''
                }
            }
        }

        stage('Pack and inspect') {
            steps {
                dir('nupkg') { deleteDir() }
                container('dotnet') {
                    sh '''
                        set -eu
                        commit=$(git -c safe.directory="$WORKSPACE" rev-parse HEAD)
                        dotnet pack "$PROJECT" -c "$CONFIG" --no-build --no-restore -o "$NUGET_OUTPUT" -p:ContinuousIntegrationBuild=true -p:RepositoryCommit="$commit"
                        sh tools/validate-release.sh package "$PROJECT" "$NUGET_OUTPUT" "$REQUESTED_REF" "$PUBLISH_REQUESTED" >> release-proof.txt
                        cat release-proof.txt
                    '''
                }
            }
        }

        stage('Push NuGet package') {
            when { expression { params.PUSH_NUGET } }
            steps {
                container('dotnet') {
                    sh '''
                        set -eu
                        sh tools/validate-release.sh package "$PROJECT" "$NUGET_OUTPUT" "$REQUESTED_REF" true >> release-proof.txt
                    '''
                    script {
                        def target = params.NUGET_TARGET ?: 'all'
                        if (target == 'all' || target == 'nuget.org') {
                            withCredentials([string(credentialsId: 'nuget-org-api-key', variable: 'NUGET_API_KEY')]) {
                                sh '''
                                    set -eu
                                    set +x
                                    for pkg in "$NUGET_OUTPUT"/*.nupkg; do
                                        dotnet nuget push "$pkg" --source "$NUGET_SOURCE" --api-key "$NUGET_API_KEY"
                                    done
                                '''
                            }
                        }
                        if (target == 'all' || target == 'private') {
                            // The private feed needs basic auth even to read its service index, so the push
                            // uses a throwaway config holding the read credential next to the API key.
                            withCredentials([
                                string(credentialsId: 'devop-nuget', variable: 'NUGET_API_KEY'),
                                usernamePassword(credentialsId: 'devop-nuget-credentials', usernameVariable: 'NUGET_USER', passwordVariable: 'NUGET_PASS')
                            ]) {
                                sh '''
                                    set -eu
                                    set +x
                                    config="$(pwd)/private-push.nuget.config"
                                    trap 'rm -f "$config"' EXIT
                                    cat > "$config" <<CONFIG
<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="private" value="$PRIVATE_NUGET_SOURCE" />
  </packageSources>
  <packageSourceCredentials>
    <private>
      <add key="Username" value="$NUGET_USER" />
      <add key="ClearTextPassword" value="$NUGET_PASS" />
    </private>
  </packageSourceCredentials>
</configuration>
CONFIG
                                    for pkg in "$NUGET_OUTPUT"/*.nupkg; do
                                        echo "Pushing $(basename "$pkg") to the private feed"
                                        dotnet nuget push "$pkg" --source private --api-key "$NUGET_API_KEY" --configfile "$config"
                                    done
                                '''
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'nupkg/**,test-results/**/*.trx,release-proof.txt', fingerprint: true, allowEmptyArchive: true
        }
    }
}
