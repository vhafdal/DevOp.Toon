<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net8.0;net9.0;netstandard2.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>DevOp.Toon</RootNamespace>
		<AssemblyName>DevOp.Toon</AssemblyName>

		<!-- Package Information -->
		<PackageId>DevOp.Toon</PackageId>
		<Version>0.4.0</Version>
		<Authors>Þorvaldur Hafdal</Authors>
		<Company>DevOp</Company>
		<Description>Token-Oriented Object Notation (TOON) - a token-efficient JSON alternative for LLM prompts</Description>
		<PackageTags>toon;format;llm;token;serialization;json</PackageTags>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageProjectUrl>https://wiki.devop.is/devop-toon/home</PackageProjectUrl>
		<RepositoryUrl>https://github.com/vhafdal/DevOp.Toon</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>DevOp.snk</AssemblyOriginatorKeyFile>
		<PublicSign>true</PublicSign>
		<Title>DevOp Toon</Title>
		<Copyright>Þorvaldur Hafdal(DevOp)</Copyright>
		<PackageIcon>Assets\DevOp.Toon-128.png</PackageIcon>
		<PackageReleaseNotes>Adds opt-in constant columns for custom 4.4 tables.
- Adds ToonEncodeOptions.ConstantColumns (default false): with CustomV4_4, a column whose value is identical in every row of a table with at least three rows is written once in the table header as Name=value; other protocol versions ignore the option and their output is unchanged; readers from 0.4.0 and earlier cannot decode output written with it, so enable it only after every reader is updated
- Adds CustomV4_4 decoding of header constants, applied to every row exactly like a cell value for typed, ToonNode and JSON targets; empty or malformed constants, constants on field groups, duplicate fields and headers without a cell column are rejected
- Improves automatic version detection: an unquoted '=' inside a table header field list now selects CustomV4_4 without a version hint, so hand-written official input that uses such an unquoted field name, which Auto decoded in 0.4.0, now fails with a row width error and needs an explicit official ProtocolVersion</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<None Include="LICENSE.md" Pack="true" PackagePath="" />
	</ItemGroup>
	<ItemGroup>
		<None Include="Assets\DevOp.Toon-128.png" Pack="true" PackagePath="Assets\" />
	</ItemGroup>
	<ItemGroup>
		<Using Include="DevOp.Toon.Core" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
		<PackageReference Include="DevOp.Toon.Core" Version="0.3.0" Condition="'$(Configuration)' != 'Debug' or '$(ToonCoreProjectPath)' == ''" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug' and '$(ToonCoreProjectPath)' != ''">
		<ProjectReference Include="$(ToonCoreProjectPath)" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
		<PackageReference Include="System.Collections.Immutable" Version="10.0.2" />
	</ItemGroup>

	<PropertyGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>


</Project>
