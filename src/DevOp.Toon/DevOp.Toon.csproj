<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net8.0;net9.0;netstandard2.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>DevOp.Toon</RootNamespace>
		<AssemblyName>DevOp.Toon</AssemblyName>

		<!-- Package Information -->
		<PackageId>DevOp.Toon</PackageId>
		<Version>0.4.0</Version>
		<Authors>Þorvaldur Hafdal</Authors>
		<Company>DevOp</Company>
		<Description>Token-Oriented Object Notation (TOON) - a token-efficient JSON alternative for LLM prompts</Description>
		<PackageTags>toon;format;llm;token;serialization;json</PackageTags>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageProjectUrl>https://wiki.devop.is/devop-toon/home</PackageProjectUrl>
		<RepositoryUrl>https://github.com/vhafdal/DevOp.Toon</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>DevOp.snk</AssemblyOriginatorKeyFile>
		<PublicSign>true</PublicSign>
		<Title>DevOp Toon</Title>
		<Copyright>Þorvaldur Hafdal(DevOp)</Copyright>
		<PackageIcon>Assets\DevOp.Toon-128.png</PackageIcon>
		<PackageReleaseNotes>Adds extension data for 4.x payloads and unquoted annotation keys in custom 4.4.
- Adds [ToonExtensionData]: 4.x typed decoding captures keys that match no member into one IDictionary&lt;string, object?&gt; or Dictionary&lt;string, object?&gt; property (objects as Dictionary&lt;string, object?&gt;, arrays as List&lt;object?&gt;, numbers as double)
- Adds 4.x encoding of extension data entries as sibling keys after the declared members, including table columns and custom 4.4 row spills; a member wins any key collision
- Adds NotSupportedException for more than one extension data property or an unsupported property type; V3_0 and CustomLegacy ignore the attribute
- Improves custom 4.4 output by writing annotation keys such as @id, @metadata, $ref, @odata.context and Raven-Clr-Type without quotes ('@' and '$' anywhere, '-' after the first character); official profiles still quote them
- Updates DevOp.Toon.Core dependency to 0.3.0</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<None Include="LICENSE.md" Pack="true" PackagePath="" />
	</ItemGroup>
	<ItemGroup>
		<None Include="Assets\DevOp.Toon-128.png" Pack="true" PackagePath="Assets\" />
	</ItemGroup>
	<ItemGroup>
		<Using Include="DevOp.Toon.Core" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
		<PackageReference Include="DevOp.Toon.Core" Version="0.3.0" Condition="'$(Configuration)' != 'Debug' or '$(ToonCoreProjectPath)' == ''" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug' and '$(ToonCoreProjectPath)' != ''">
		<ProjectReference Include="$(ToonCoreProjectPath)" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
		<PackageReference Include="System.Collections.Immutable" Version="10.0.2" />
	</ItemGroup>

	<PropertyGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>


</Project>
