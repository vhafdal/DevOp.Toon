<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <IsPackable>false</IsPackable>
    <RuntimePackageVersion Condition="'$(RuntimePackageVersion)' == ''">0.3.0</RuntimePackageVersion>
    <CorePackageVersion Condition="'$(CorePackageVersion)' == '' and '$(RuntimePackageVersion)' == '0.2.9'">0.1.3</CorePackageVersion>
    <CorePackageVersion Condition="'$(CorePackageVersion)' == ''">0.2.0</CorePackageVersion>
    <DefineConstants Condition="'$(RuntimePackageVersion)' == '0.2.9'">$(DefineConstants);BASELINE</DefineConstants>
    <UseLocalToonCoreProject>false</UseLocalToonCoreProject>
    <UseLocalToonApiProject>false</UseLocalToonApiProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DevOp.Toon" Version="$(RuntimePackageVersion)" />
    <PackageReference Include="DevOp.Toon.Core" Version="$(CorePackageVersion)" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../DevOp.Toon.ProtocolBenchmarks/Program.cs" Link="Program.cs" />
    <Compile Include="../DevOp.Toon.Benchmarks/Models/Product.cs" Link="Product.cs" />
  </ItemGroup>
</Project>
